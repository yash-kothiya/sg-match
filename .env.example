# Copy to .env and fill in. Never commit .env. All of these are server-side only.

# Postgres with pgvector (Supabase: Connect > Session pooler URI, port 5432)
DATABASE_URL=

# Firebase (auth + chat history in Firestore). Service account from Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=

# Gemini (study guide chatbot only). Model ids change; confirm them with `bun run ai:check`.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional, comma-separated: tried in order when the chat model keeps returning 5xx.
GEMINI_CHAT_FALLBACK_MODELS=
